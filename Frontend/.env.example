# Copy to .env.local for local development, then restart Vite.
# Public addresses only: never put passwords or keys in VITE_ variables,
# because everything here is built into the pages the browser downloads.

# The backend's catalogue API. Every other API address is derived from it.
VITE_CATALOGUE_API_URL=http://localhost:8080/api/catalogue

# Optional. A whole number: variants with this much stock or less show "Low Stock".
# VITE_CATALOGUE_LOW_STOCK_THRESHOLD=10

# Optional. Shown in the footer as the contact address.
# VITE_BRIGHTBUY_CONTACT_EMAIL=support@example.com
