# Reference template only: Spring does not automatically load .env files.
# Copy to ignored .env.local, fill values, then export/source it in your terminal.
BRIGHTBUY_DB_URL="jdbc:mysql://localhost:33087/brightbuy"
BRIGHTBUY_DB_USERNAME="brightbuy_local"
BRIGHTBUY_DB_PASSWORD="replace_with_your_local_test_password"
BRIGHTBUY_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
BRIGHTBUY_SECURE_COOKIES=false
BRIGHTBUY_COOKIE_SAME_SITE=lax
# Production HTTPS needs Secure cookies; cross-site deployments need SameSite=none.
# Database TLS and credentials are configured privately by the deployment owner.
# Production: activate catalogue,inventory,production (in that order).
# SPRING_PROFILES_ACTIVE="catalogue,inventory,production"
# BRIGHTBUY_DB_URL="jdbc:mysql://YOUR_DB_HOST/brightbuy?sslMode=VERIFY_IDENTITY"
# BRIGHTBUY_CORS_ORIGINS="https://YOUR_FRONTEND_HOST"
# BRIGHTBUY_COOKIE_SAME_SITE=lax (same-site) or none (cross-site HTTPS).
# The production profile forces Secure cookies and refuses unsafe settings.
