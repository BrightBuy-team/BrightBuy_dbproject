# Backend settings. Spring does not read .env files: copy this to .env.local
# (ignored by git), fill it in, then load it into the terminal that starts the backend:
#   set -a; source .env.local; set +a; ./mvnw spring-boot:run
# Never commit real values.

# MySQL account. Grant it the brightbuy_application role only
# (Database/Shared/03_database_roles.sql); do not use root.
BRIGHTBUY_DB_URL="jdbc:mysql://localhost:3306/brightbuy"
BRIGHTBUY_DB_USERNAME="brightbuy_app"
BRIGHTBUY_DB_PASSWORD="replace_with_your_local_password"

# Browser addresses allowed to call the API.
BRIGHTBUY_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Session cookie. Local HTTP needs false; HTTPS needs true.
# Use SameSite "none" only when the frontend is on a different site, over HTTPS.
BRIGHTBUY_SECURE_COOKIES=false
BRIGHTBUY_COOKIE_SAME_SITE=lax

# Card payments: "simulated" accepts the documented test cards only;
# "disabled" turns card checkout off and leaves cash on delivery working.
BRIGHTBUY_PAYMENT_GATEWAY=simulated

# First administrator. Set both once on a new system (password of 12 or more
# characters), start the backend, sign in, then remove them again.
# BRIGHTBUY_BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BRIGHTBUY_BOOTSTRAP_ADMIN_PASSWORD=""

# Production: also set SPRING_PROFILES_ACTIVE=production. That profile requires
# TLS to the database, HTTPS-only cookies and explicit HTTPS origins, and the
# backend refuses to start if any of them is unsafe.
# SPRING_PROFILES_ACTIVE="production"
# BRIGHTBUY_DB_URL="jdbc:mysql://YOUR_DB_HOST:3306/brightbuy?sslMode=VERIFY_IDENTITY"
# BRIGHTBUY_CORS_ORIGINS="https://YOUR_FRONTEND_HOST"
